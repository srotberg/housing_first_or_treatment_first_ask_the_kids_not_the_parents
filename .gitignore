# build artefacts
code/simple/hftf_*
code/simple/check_hours
code/simple/t1
code/simple/diag
code/simple/diag2
code/simple/*.o
code/simple/*.mod
code/simple/*.log
code/simple/smoke
code/simple/hftf_mech
