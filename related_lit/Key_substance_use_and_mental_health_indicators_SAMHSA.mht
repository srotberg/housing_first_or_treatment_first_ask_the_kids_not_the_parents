------MultipartBoundary--O9LIVsQnrxLQ8ef9Sb1F4bNozkElJxxD7dfwdJmt4B----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.samhsa.gov/data/themes/custom/samhsa_data/css/webready-html-content.css

@charset "utf-8";

* { font-size: 100%; font-family: Tahoma, Verdana, Segoe, sans-serif !important; }

body { font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 15px; line-height: 20px; }

body .l-main { font-style: normal; font-weight: 400; }

body .l-main a { color: rgb(31, 65, 154); }

body .l-main a:hover { color: rgb(30, 56, 75); cursor: pointer; }

.l-content p { margin: 0px 0px 10px; font-size: 15px; line-height: 20px; }

p { line-height: 20px; }

ol li, p, ul li { color: rgb(74, 74, 74); font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 15px; font-weight: 400; letter-spacing: normal; padding: 0px; margin: 0px 0px 10px; }

ol li, ul li { line-height: normal; }

h1 { color: rgb(30, 56, 75); font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 28px; font-weight: 700; letter-spacing: normal; line-height: 30px; padding: 0px; margin: 0px 0px 10px; }

@media (min-width: 39em) {
  h1 { font-size: 32px; line-height: 34px; }
}

h2 { color: rgb(30, 56, 75); font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 23px; font-weight: 700; letter-spacing: normal; line-height: 25px; padding: 0px; margin: 0px 0px 10px; }

@media (min-width: 39em) {
  h2 { font-size: 28px; line-height: 30px; }
}

h3 { color: rgb(30, 56, 75); font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 18px; font-weight: 700; letter-spacing: normal; line-height: 20px; padding: 0px; margin: 0px 0px 10px; }

@media (min-width: 39em) {
  h3 { font-size: 21px; line-height: 22px; }
}

h4 { color: rgb(30, 56, 75); font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 16px; font-weight: 700; letter-spacing: normal; line-height: 18px; padding: 0px; margin: 0px 0px 10px; }

@media (min-width: 39em) {
  h4 { font-size: 16px; line-height: 18px; }
}

h5 { color: rgb(30, 56, 75); font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 15px; font-weight: 700; letter-spacing: normal; line-height: 16px; padding: 0px; margin: 0px 0px 10px; }

@media (min-width: 39em) {
  h5 { font-size: 15px; line-height: 16px; }
}

.samhsa-data-link { color: rgb(0, 51, 153); text-decoration: none; cursor: pointer; }

.samhsa-data-link:hover { color: rgb(205, 56, 53); cursor: pointer; }

.samhsa-data-text { color: rgb(74, 74, 74); font-size: 15px; font-weight: 400; line-height: 20px; }

.samhsa-data-text a { color: rgb(0, 51, 153); text-decoration: none; cursor: pointer; }

.samhsa-data-text a:hover { color: rgb(205, 56, 53); cursor: pointer; }

.samhsa-data-title-text { display: block; font-size: 15px; font-weight: 700; line-height: 20px; }

.samhsa-data-title-text a { color: rgb(0, 51, 153); text-decoration: none; cursor: pointer; }

.samhsa-data-title-text a:hover { color: rgb(205, 56, 53); cursor: pointer; }

.samhsa-data-form-input-txt-style1 { font-size: 15px; font-weight: 400; letter-spacing: 0.5px; color: rgb(84, 84, 84); background-color: rgb(255, 255, 255); padding: 10px 15px; height: 45px; border: 1px solid rgb(155, 155, 155); }

@media (min-width: 39em) {
  .samhsa-data-form-input-txt-style1 { font-size: 17px; }
}

.samhsa-data-form-input-txt-style1:focus { border-color: rgb(95, 142, 228); box-shadow: rgba(95, 142, 228, 0.2) 0px 0px 0px 2px; }

.samhsa-data-form-checkbox-style1 { font-size: 14px; font-weight: 400; letter-spacing: 0.03em; color: rgb(74, 74, 74); }

.samhsa-data-form-checkbox-style1:checked, .samhsa-data-form-checkbox-style1:focus { background: rgb(169, 100, 1); }

.samhsa-data-form-radio-style1 { font-size: 14px; font-weight: 400; letter-spacing: 0.03em; color: rgb(74, 74, 74); }

.samhsa-data-form-radio-style1:checked, .samhsa-data-form-radio-style1:focus { background: rgb(169, 100, 1); }

.samhsa-data-form-select-dd-style1 { font-size: 14px; font-weight: 400; letter-spacing: 0.03em; color: rgb(74, 74, 74); padding: 4px; border: 1px solid rgb(212, 212, 212); }

.samhsa-data-form-select-dd-style1:focus { background: rgb(204, 204, 204); }

option .samhsa-data-form-select-dd-style1:hover { background-color: rgb(204, 204, 204); }

.samhsa-data-form-submit-style1 { display: inline-block; background: rgb(21, 96, 124); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); font-size: 16px; font-weight: 400; letter-spacing: normal; margin: 0px; padding: 15px 20px; text-decoration: none; text-transform: capitalize; text-align: center; appearance: none; box-shadow: none; border-radius: 0px; width: auto; height: 45px; line-height: 15px; }

@media (min-width: 39em) {
  .samhsa-data-form-submit-style1 { font-size: 16px; line-height: 18px; }
}

.samhsa-data-form-submit-style1:focus { outline: none; }

.samhsa-data-form-submit-style1:hover { background-color: rgb(95, 99, 106); }

.samhsa-data-form-submit-style2 { display: inline-block; background: rgb(255, 255, 255); border: 1px solid rgb(74, 74, 74); color: rgb(74, 74, 74); font-size: 15px; font-weight: 700; letter-spacing: 1px; margin: 0px; text-decoration: none; text-transform: uppercase; text-align: center; appearance: none; box-shadow: none; border-radius: 0px; width: auto; height: 45px; line-height: 15px; }

@media (min-width: 39em) {
  .samhsa-data-form-submit-style2 { font-size: 18px; line-height: 18px; }
}

.samhsa-data-form-submit-style2:focus { outline: none; }

.samhsa-data-form-submit-style2:hover { background-color: rgb(169, 100, 1); color: rgb(255, 255, 255); border: 1px solid rgb(169, 100, 1); }

.samhsa-data-link-button-style1 { display: inline-block; background: rgb(21, 96, 124); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); font-size: 16px; font-weight: 400; letter-spacing: normal; margin: 0px; padding: 15px 20px; text-decoration: none; text-transform: capitalize; text-align: center; appearance: none; box-shadow: none; border-radius: 0px; width: auto; height: auto; line-height: 15px; }

@media (min-width: 39em) {
  .samhsa-data-link-button-style1 { font-size: 15px; line-height: 15px; }
}

.samhsa-data-link-button-style1:focus { outline: none; }

.samhsa-data-link-button-style1:hover { background-color: rgb(95, 99, 106); }

.samhsa-data-link-button-style2 { display: inline-block; background: rgb(255, 255, 255); border: 1px solid rgb(21, 96, 124); color: rgb(21, 96, 124); font-size: 16px; font-weight: 400; letter-spacing: 1px; margin: 0px; padding: 15px; text-decoration: none; text-transform: capitalize; text-align: center; appearance: none; box-shadow: none; border-radius: 0px; width: auto; height: auto; line-height: 15px; }

@media (min-width: 39em) {
  .samhsa-data-link-button-style2 { font-size: 15px; line-height: 15px; }
}

.samhsa-data-link-button-style2:focus { outline: none; }

.samhsa-data-link-button-style2:hover { background: rgb(255, 255, 255); color: rgb(95, 99, 106); border: 1px solid rgb(95, 99, 106); }

.samhsa-data-ul-list { list-style: outside none disc; margin: 15px 0px 15px 15px; padding: 0px 0px 0px 18px; }

.samhsa-data-ul-list-li { list-style: outside none disc; padding: 0px 0px 0px 5px; margin: 0px 0px 10px; }

.samhsa-data-ol-list { margin: 15px 0px 15px 15px; padding: 0px 0px 0px 18px; }

.samhsa-data-ol-list-li { padding: 0px 0px 0px 5px; margin: 0px 0px 10px; }

.samhsa-data-list-as-block, .samhsa-data-list-item-block { list-style: none; margin: 0px; padding: 0px; }

.samhsa-data-list-item-block, .samhsa-data-list-item-block a { display: inline-block; }

.samhsa-data-clear-block { display: block; clear: both; float: none; width: 100%; padding: 0px; margin: 0px; overflow: hidden; }

.clearfix::after { visibility: hidden; display: block; font-size: 0px; content: ""; clear: both; height: 0px; }

.hidden { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }

.accessible-alt { position: absolute; top: -9999px; left: -9999px; }

.svg-icon { display: inline-block; width: 100%; height: 100%; fill: currentcolor; }

.list-unstyled { list-style: none; }

.list-inline-pipes li { display: inline; border-right: 1px solid rgb(163, 167, 169); }

.list-inline-pipes li:last-of-type { border-right: 0px; }

div, p { margin: 0px 0px 10px; padding: 0px; }

div, p, table { color: rgb(74, 74, 74); font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 15px; font-weight: 400; letter-spacing: normal; line-height: 20px; }

table { border-collapse: collapse; text-align: left; width: 100%; border: 1px solid rgb(212, 212, 212); }

table th, table tr th { font-weight: 700; }

table td, table th, table tr td, table tr th { font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 15px; padding: 4px; border: 1px solid rgb(212, 212, 212); }

table td, table tr td { font-weight: 400; }

.content-image-center-lg { width: 100%; max-width: 1000px; }

.content-image-center-md { width: 100%; max-width: 700px; }

.content-image-center-sm { width: 100%; max-width: 480px; }

.content-image-column-lg { width: 100%; max-width: 575px; }

.content-image-column-md { width: 100%; max-width: 400px; }

.content-image-column-sm { width: 100%; max-width: 280px; }

.table-image-center-lg { width: 100%; max-width: 768px; }

.table-image-center-md { width: 100%; max-width: 535px; }

.table-image-center-sm { width: 100%; max-width: 375px; }

.table-image-column-lg { width: 100%; max-width: 475px; }

.table-image-column-md { width: 100%; max-width: 330px; }

.table-image-column-sm { width: 100%; max-width: 230px; }

input[type="text"] { font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 18px; font-weight: 400; letter-spacing: 0.5px; color: rgb(95, 99, 106); background-color: rgb(255, 255, 255); padding: 10px 15px; height: 45px; border: 1px solid rgb(205, 205, 205); }

input[type="text"]:active, input[type="text"]:focus, input[type="text"]:hover { border-color: rgb(95, 142, 228); box-shadow: rgba(95, 142, 228, 0.2) 0px 0px 0px 2px; }

input[type="radio"] { font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 13px; font-weight: 400; letter-spacing: 0.03em; color: rgb(74, 74, 74); }

input[type="radio"]:checked, input[type="radio"]:focus { background: rgb(169, 100, 1); }

select { font-family: Tahoma, Verdana, Segoe, sans-serif; font-size: 14px; font-weight: 400; letter-spacing: 0.03em; color: rgb(74, 74, 74); padding: 15px; border: 1px solid rgb(205, 205, 205); }

