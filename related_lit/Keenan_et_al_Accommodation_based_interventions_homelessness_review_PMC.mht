@charset "utf-8";

.iziToast-capsule { font-size: 0px; height: 0px; width: 100%; transform: translateZ(0px); backface-visibility: hidden; transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1), height 0.5s cubic-bezier(0.25, 0.8, 0.25, 1); }

.iziToast-capsule, .iziToast-capsule * { box-sizing: border-box; }

.iziToast-overlay { display: block; position: fixed; inset: -100px 0px; z-index: 997; }

.iziToast { display: inline-block; clear: both; position: relative; font-family: Lato, Tahoma, Arial; font-size: 14px; padding: 8px 45px 9px 0px; background: rgba(238, 238, 238, 0.9); border-color: rgba(238, 238, 238, 0.9); width: 100%; pointer-events: all; cursor: default; transform: translate(0px); user-select: none; min-height: 54px; }

.iziToast > .iziToast-progressbar { position: absolute; left: 0px; bottom: 0px; width: 100%; z-index: 1; background: rgba(255, 255, 255, 0.2); }

.iziToast > .iziToast-progressbar > div { height: 2px; width: 100%; background: rgba(0, 0, 0, 0.3); border-radius: 0px 0px 3px 3px; }

.iziToast.iziToast-balloon::before { content: ""; position: absolute; right: 8px; left: auto; width: 0px; height: 0px; top: 100%; border-right: 0px solid transparent; border-left: 15px solid transparent; border-top-width: 10px; border-top-style: solid; border-top-color: inherit; border-radius: 0px; }

.iziToast.iziToast-balloon .iziToast-progressbar { top: 0px; bottom: auto; }

.iziToast.iziToast-balloon > div { border-radius: 0px 0px 0px 3px; }

.iziToast > .iziToast-cover { position: absolute; left: 0px; top: 0px; bottom: 0px; height: 100%; margin: 0px; background-size: 100%; background-position: 50% 50%; background-repeat: no-repeat; background-color: rgba(0, 0, 0, 0.1); }

.iziToast > .iziToast-close { position: absolute; right: 0px; top: 0px; border: 0px; padding: 0px; opacity: 0.6; width: 42px; height: 100%; background: url("data:image/png;base64,") 50% 50% / 8px no-repeat; cursor: pointer; outline: none; }

.iziToast > .iziToast-close:hover { opacity: 1; }

.iziToast > .iziToast-body { position: relative; padding: 0px 0px 0px 10px; height: auto; min-height: 36px; margin: 0px 0px 0px 15px; text-align: left; }

.iziToast > .iziToast-body::after { content: ""; display: table; clear: both; }

.iziToast > .iziToast-body .iziToast-texts { margin: 10px 0px 0px; padding-right: 2px; display: inline-block; float: left; }

.iziToast > .iziToast-body .iziToast-inputs { min-height: 19px; float: left; margin: 3px -2px; }

.iziToast > .iziToast-body .iziToast-inputs > input:not([type="checkbox"]):not([type="radio"]), .iziToast > .iziToast-body .iziToast-inputs > select { position: relative; display: inline-block; margin: 2px; border-radius: 2px; border: 0px; padding: 4px 7px; font-size: 13px; letter-spacing: 0.02em; background: rgba(0, 0, 0, 0.1); color: rgb(0, 0, 0); box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 0px 1px; min-height: 26px; }

