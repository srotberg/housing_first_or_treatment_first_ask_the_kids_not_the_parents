#figureCanvas .figBox > img { max-height: 100%; max-width: 100%; user-select: none; }

#refCanvas { position: relative; width: auto; max-width: 870px; min-height: 200px; margin: 0px; background: rgb(255, 255, 255); text-align: center; }

#refCanvas .figBox { float: none; display: block; width: auto; max-width: 800px; margin: 0px auto 15px; padding: 10px 0px 0px; border-top: 1px solid rgb(204, 204, 204); background: rgb(255, 255, 255); }

#figureCanvas #figTools, #refCanvas #figTools { position: absolute; top: 10px; left: 3px; text-align: left; }

#figTools div { height: 19px; margin: 0px 0px 5px; overflow: hidden; }

#figTools div a { display: block; height: 19px; }

#figTools div a span { display: block; }

#figTools div a:hover { background-position: 0px -19px; }

#figTools div.weo { width: auto; max-width: 105px; }

#figTools div.weo a { background: url("/templates/jsp/images/icon-weo.gif") no-repeat; }

#figTools div.highRes { width: auto; max-width: 115px; }

#figTools div.highRes a { font-size: 12px; }

#figTools div.ppt { width: auto; max-width: 168px; }

#figureCanvas .caption, #refCanvas .caption { margin: 7px 7px 0px; padding: 10px 0px 15px; border-top: 1px solid rgb(204, 204, 204); text-align: left; width: auto; }

#figureViewer-footer, #refViewer-footer { display: block; text-align: center; border-top: 1px solid rgb(204, 204, 204); margin: 7px 7px 0px; padding: 10px 0px; }

#figureViewer-footer .highRes { margin-top: 5px; }

#refViewer-wrap #figureViewer-footer, #refViewer-wrap #refViewer-footer { background: url("/templates/jsp/images/figureViewer-bg2.gif") repeat-y rgb(227, 225, 226); text-align: right; }

.figureNav a { float: left; margin-top: 22px; background: 0px center; color: rgb(255, 255, 255); text-decoration: none; font-size: 20px; }

.figureNav a.prev { margin-right: 42px; }

.figureNav a:hover { color: rgb(69, 148, 187); }

.figureNav a.disabled { background: 0px center; display: block !important; }

.figureNav a.browse { background: url("/templates/jsp/_style2/images/fv_browse.png") 0px 0px no-repeat; width: 20px; height: 20px; margin: 22px 25px 0px 22px; cursor: pointer; }

#figureViewerNav a.prev, #refViewerNav a.prev { top: 0px; left: 0px; }

#figureViewerNav a.next, #refViewerNav a.next { top: 0px; right: 0px; }

#figureViewerNav .figureNav span, #refViewerNav .figureNav span { vertical-align: bottom; }

.figure .altMedium, .figure .altLarge, .figureNav .disabled, .disabled { display: none !important; }

.figure-actions { background: rgb(204, 204, 204); color: rgb(98, 98, 98); border: 1px solid rgb(204, 204, 204); font-weight: normal; transition: background 200ms linear; }

.figure-actions .collapse-expand-icon { color: rgb(153, 153, 153); display: inline-block; margin-right: 25px; cursor: pointer; height: 14px; width: 14px; vertical-align: middle; background: url("/templates/jsp/_style2/_rsdTheme/pb2/img/fv_plus_minus.png") 0px 0px no-repeat; }

.figure-actions .collapse-expand-icon.expand { background-position: 0px -14px; }

.figure-actions.white { background: rgb(255, 255, 255); border: 1px solid rgb(196, 192, 183); }

.figuresContent { padding-top: 0px; }

.figuresContent .holder .thumbnail { display: block; border-bottom: 1px solid rgb(204, 204, 204); border-left: 1px solid rgb(204, 204, 204); border-right: 1px solid rgb(204, 204, 204); text-align: center; cursor: zoom-in; }

.figuresContent .caption { font-size: 14px; color: rgb(0, 0, 0); font-family: "Helvetica Neue", Helvetica, sans-serif; }

.figuresContent .caption .captionLabel { display: block; margin-bottom: 5px; }

.figuresContent img { max-width: 100%; }

@media (max-width: 400px) {
  .figureViewer-overlay .figureViewer-navigation .zoom-slider { width: 60px; }
  .figureNav a.prev { margin-right: 30px; }
}

.slideshowWidget { position: relative; font-family: helvetica, sans-serif; }

.slideshowWidget .slidePort { position: relative; overflow-x: hidden; }

.slideshowWidget .slide { position: absolute; top: 0px; left: 0px; display: none; }

.pb-wrap .genericSlideshow .slide div.pb-selected, .pb-wrap .genericSlideshow .slide div.pb-hover { margin-top: 16px; }

.slideshowWidget .slide1 { display: block; }

.slideshowWidget .slide a { display: block; text-decoration: none; }

.slideshowWidget .slide img { display: block; }

.slideshowWidget.animate-slide .slides { position: absolute; white-space: nowrap; }

.slideshowWidget.animate-slide .slide { position: relative; display: inline-block; vertical-align: text-top; }

.slideshowWidget.animate-slide .slide .widget { white-space: normal; margin: 0px; }

.slideshowWidget .slideMeta { position: absolute; top: 0px; left: 0px; max-width: 70%; padding: 5px; white-space: normal; background-color: rgba(0, 0, 0, 0.65); }

.slideshowWidget .slideTitle { margin: 0px 0px 5px; padding: 0px; font-size: 14px; line-height: normal; font-weight: normal; color: rgb(255, 255, 255); }

.slideshowWidget .slideAuthors { font-size: 11px; line-height: normal; color: rgb(255, 255, 255); }

.slideshowWidget .slideCaption { display: none; }

.slideshowWidget .slideNav { display: none; position: relative; float: right; bottom: 3px; right: 3px; vertical-align: middle; user-select: none; z-index: 5; padding-top: 5px; }

.slideshowWidget .previousSlide, .nextSlide { display: inline-block; padding: 0px 5px 1px; font-size: 16px; text-align: center; background: rgb(51, 51, 51); color: rgb(255, 255, 255); cursor: pointer; transition: background-color 200ms; }

.slideshowWidget .previousSlide:hover, .nextSlide:hover { background-color: rgb(51, 102, 153); }

.slideshowWidget .navIndicator { display: block; list-style-type: circle; height: 15px; margin: 5px 0px 0px; padding: 0px; text-align: center; overflow: hidden; user-select: none; }

.slideshowWidget .navIndicator li { display: inline-block; width: 10px; height: 10px; margin: 5px 2px 0px; padding: 0px; background: rgb(204, 204, 204); vertical-align: top; overflow: hidden; cursor: pointer; transition: background-color 1s; }

.slideshowWidget .navIndicator span { display: none; }

.slideshowWidget.dotNav .navIndicator li { border-radius: 50%; background-clip: padding-box; }

.slideshowWidget .navIndicator .active, .navIndicator .active:hover { background-color: rgb(51, 51, 51); cursor: default; }

.slideshowWidget .navIndicator li:hover { background-color: rgb(51, 102, 153); }

.slideshowWidget.numNav .navIndicator { height: 27px; text-align: left; }

.slideshowWidget.numNav .navIndicator li { width: 20px; height: 20px; margin: 5px 4px 0px 0px; line-height: 20px; font-family: inherit; color: rgb(51, 51, 51); text-align: center; }

.slideshowWidget.numNav .navIndicator span { display: inline; vertical-align: middle; transition: color 1s; }

.slideshowWidget.numNav .navIndicator .active, .slideshowWidget.numNav .navIndicator .active:hover { background: rgb(51, 102, 153); color: rgb(255, 255, 255); }

.slideshowWidget.numNav .navIndicator li:hover { background: rgb(51, 102, 153); color: rgb(255, 255, 255); }

.slideshowWidget.numNav .navIndicator li:hover span { }

.slideshowWidget .slideshowCaption { margin-top: 10px; font-size: 11px; }

.slideshowWidget.noNav .navIndicator { display: none; visibility: hidden; }

.play-options { display: inline-block; }

.collapsed .icon-arrow_u_p { display: inline-block; transform: rotate(180deg); }

