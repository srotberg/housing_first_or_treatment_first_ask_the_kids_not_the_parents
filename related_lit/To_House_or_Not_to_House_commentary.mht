#figureCanvas .img-pan-container { position: relative; overflow: hidden; cursor: crosshair; height: 100%; width: 100%; }

#figureCanvas .img-pan-container img { transform: translateZ(0px); position: absolute; top: 0px; left: 0px; }

#figureCanvas .figBox { height: 100%; overflow: auto; user-select: none; }

