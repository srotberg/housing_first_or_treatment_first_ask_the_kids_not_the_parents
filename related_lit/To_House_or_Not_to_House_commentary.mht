.custom-checkbox { position: absolute; left: -9999px; visibility: hidden; }

.custom-checkbox + label, .cmn-toggle + label { position: relative; padding-left: 35px; cursor: pointer; display: inline-block; height: 25px; line-height: 25px; font-size: 1rem; user-select: none; }

.custom-checkbox:indeterminate + label::before { left: -10px; top: -11px; width: 10px; height: 22px; border-width: medium 2px medium medium; border-style: none solid none none; border-color: currentcolor rgb(38, 166, 154) currentcolor currentcolor; transform: rotate(90deg); backface-visibility: hidden; transform-origin: 100% 100%; }

.custom-checkbox:indeterminate:disabled + label::before { border-right: 2px solid rgba(0, 0, 0, 0.26); background-color: transparent; }

.custom-checkbox + label::before, .custom-checkbox + label::after, .cmn-toggle + label::before, .cmn-toggle + label::after { content: ""; left: 0px; position: absolute; z-index: 1; }

.custom-checkbox + label::before { width: 0px; height: 0px; border: 3px solid transparent; left: 6px; top: 10px; transform: rotateZ(37deg); transform-origin: 100% 100%; }

.custom-checkbox + label::after { height: 20px; width: 20px; background-color: transparent; border: 1px solid rgb(32, 76, 139); top: 3px; z-index: 0; }

.custom-checkbox:checked + label::before { top: 5px; left: 2px; width: 7px; height: 12px; border-width: 1px; border-style: solid; border-color: transparent rgb(32, 76, 139) rgb(32, 76, 139) transparent; transform: rotateZ(37deg); transform-origin: 100% 100%; }

.custom-checkbox:checked + label::after { top: 3px; width: 20px; height: 20px; border: 1px solid rgb(32, 76, 139); z-index: 0; }

.custom-checkbox:disabled:not(:checked) + label::before { background-color: transparent; border: 2px solid transparent; }

.custom-checkbox:disabled:not(:checked) + label::after { border-color: transparent; background-color: rgb(189, 189, 189); }

.custom-checkbox:disabled:checked + label::before { background-color: transparent; }

.custom-checkbox:disabled:checked + label::after { background-color: rgb(189, 189, 189); border-color: rgb(189, 189, 189); }

